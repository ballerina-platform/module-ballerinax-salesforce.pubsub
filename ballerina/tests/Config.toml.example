[ballerinax.salesforce.pubsub]
# Copy this file to tests/Config.toml. Config.toml is gitignored: never commit credentials.
pubsubSandboxTests = true
sandboxEndpoint = "https://your-org.my.salesforce.com"
sandboxAccessToken = "<ACCESS_TOKEN>"
sandboxClientId = "<CLIENT_ID>"
sandboxClientSecret = "<CLIENT_SECRET>"
sandboxRefreshUrl = "https://your-org.my.salesforce.com/services/oauth2/token"
sandboxUsername = "<SF_USERNAME>"
sandboxPassword = "<SF_PASSWORD>"
sandboxTenantId = "<PUBSUB_TENANT_ID>"
